  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Balanced Plan : \n1 Set Chest press , 1 Set Deadlift , 2 Set Sit-Ups\n\nPropper
    Chest press technique : Lie flat, feet on the floor, grip bar slightly wider
    than shoulders.\r\nLift bar above chest, arms extended.\r\nInhale, lower bar
    to mid-chest, elbows at 45\xB0.\r\nExhale, push bar back up, keeping control.\n\nPropper
    Deadlift technique : Stand with feet hip-width apart, bar over mid-foot.\r\nBend
    at hips and knees, grip bar just outside knees.\r\nExhale, straighten hips and
    knees, lift bar close to body.\r\nStand tall, shoulders back, hips fully extended.\n\nPropper
    Sit-Ups technique : Lie on your back, knees bent, feet flat on the floor.\r\nPlace
    hands behind your head\r\nExhale, lift your upper body towards your knees using
    your core.\r\nInhale, slowly lower back down to the starting position.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
